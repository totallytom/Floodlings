{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "adtest": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FORCE_TEST_ADS": "true"
      }
    },
    "internal": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {},
    "internal": {
      "android": {
        "track": "internal"
      }
    }
  }
}
