{
  "expo": {
    "name": "Floodlings",
    "slug": "ColorFill",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "colorflood",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amuletstudios.colorfill",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "ja", "de", "ko", "es", "pt"],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "locales": {
      "ja": "./languages/ja.json",
      "de": "./languages/de.json",
      "ko": "./languages/ko.json",
      "es": "./languages/es.json",
      "pt": "./languages/pt.json"
    },
    "android": {
      "package": "com.amuletstudios.colorfill",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withoutMediaPlaybackService",
      "./plugins/withPinnedNdkVersion",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3981993675235210~2567168174",
          "iosAppId": "ca-app-pub-3981993675235210~7928993849",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ],
      "expo-tracking-transparency",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "386fb8c3-9f52-4d8a-bde7-00c171e33f0c"
      }
    },
    "owner": "totallytom"
  }
}
